@page "/socios"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inherits PaginaProtegida
@inject SocioApiService SocioApi

<PageTitle>Socios · BiblioTech</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Socios</h1>
    <a class="btn btn-primary" href="socios/nuevo">+ Nuevo socio</a>
</div>

<Alerta Mensaje="@mensaje" Tipo="@tipoMensaje" OnCerrar="() => mensaje = null" />

@if (socios is null)
{
    @if (mensaje is null) { <Cargando /> }
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Documento</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th class="text-center">Préstamos activos</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var socio in socios)
                {
                    <tr class="@(socio.Activo ? "" : "text-secondary")">
                        <td>@socio.Documento</td>
                        <td>@socio.Nombre</td>
                        <td>@socio.Email</td>
                        <td class="text-center">@socio.PrestamosActivos</td>
                        <td class="text-center">
                            <span class="badge @(socio.Activo ? "text-bg-success" : "text-bg-secondary")">
                                @(socio.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="socios/editar/@socio.Id">Editar</a>
                            @if (socio.Activo)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => porDesactivar = socio">Desactivar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmarModal Visible="porDesactivar is not null"
                Titulo="Desactivar socio"
                Mensaje="@($"¿Desactivar a {porDesactivar?.Nombre}? No podrá pedir préstamos, pero se conserva su historial.")"
                TextoConfirmar="Desactivar"
                OnConfirmar="DesactivarAsync"
                OnCancelar="() => porDesactivar = null" />

@code {
    private List<SocioDto>? socios;
    private SocioDto? porDesactivar;
    private string? mensaje;
    private string tipoMensaje = "danger";

    protected override async Task CargarAsync()
    {
        try
        {
            socios = await SocioApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            (mensaje, tipoMensaje) = (ex.Message, "danger");
        }
    }

    private async Task DesactivarAsync()
    {
        var socio = porDesactivar!;
        porDesactivar = null;
        try
        {
            await SocioApi.DesactivarAsync(socio.Id);   // DELETE = borrado lógico
            (mensaje, tipoMensaje) = ($"{socio.Nombre} quedó inactivo.", "success");
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            (mensaje, tipoMensaje) = (ex.Message, "danger");
        }
    }
}
