@page "/socios/nuevo"
@page "/socios/editar/{Id:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inherits PaginaProtegida
@inject SocioApiService SocioApi
@inject NotificacionService Notificaciones

<PageTitle>@Titulo · BiblioTech</PageTitle>

<h1 class="h3 mb-3">@Titulo</h1>

<Alerta Mensaje="@error" Tipo="danger" OnCerrar="() => error = null" />

@if (!cargado)
{
    @if (error is null) { <Cargando /> }
}
else
{
    <div class="card shadow-sm" style="max-width: 560px">
        <div class="card-body">
            <EditForm Model="modelo" OnValidSubmit="GuardarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="documento">Documento</label>
                    <InputText id="documento" class="form-control" @bind-Value="modelo.Documento" />
                    <ValidationMessage For="() => modelo.Documento" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="nombre">Nombre</label>
                    <InputText id="nombre" class="form-control" @bind-Value="modelo.Nombre" />
                    <ValidationMessage For="() => modelo.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="email">Correo</label>
                    <InputText id="email" type="email" class="form-control" @bind-Value="modelo.Email" />
                    <ValidationMessage For="() => modelo.Email" />
                </div>

                @if (Id is not null)
                {
                    <div class="form-check mb-3">
                        <InputCheckbox id="activo" class="form-check-input" @bind-Value="modelo.Activo" />
                        <label class="form-check-label" for="activo">Socio activo (puede pedir préstamos)</label>
                    </div>
                }

                <button type="submit" class="btn btn-primary mt-2" disabled="@guardando">Guardar</button>
                <a class="btn btn-outline-secondary ms-2 mt-2" href="socios">Cancelar</a>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private SocioGuardarDto modelo = new();
    private bool cargado;
    private bool guardando;
    private string? error;

    private string Titulo => Id is null ? "Nuevo socio" : "Editar socio";

    protected override async Task CargarAsync()
    {
        try
        {
            if (Id is not null)
            {
                var socio = await SocioApi.ObtenerAsync(Id.Value);
                modelo = new SocioGuardarDto
                {
                    Documento = socio.Documento,
                    Nombre = socio.Nombre,
                    Email = socio.Email,
                    Activo = socio.Activo
                };
            }
            cargado = true;
        }
        catch (ApiException ex)
        {
            error = ex.Message;
        }
    }

    private async Task GuardarAsync()
    {
        guardando = true;
        error = null;
        try
        {
            if (Id is null)
                await SocioApi.CrearAsync(modelo);
            else
                await SocioApi.ActualizarAsync(Id.Value, modelo);

            Notificaciones.Guardar(Id is null
                ? $"Se creó el socio {modelo.Nombre}."
                : $"Se actualizó el socio {modelo.Nombre}.");
            Nav.NavigateTo("socios");
        }
        catch (ApiException ex)
        {
            error = ex.Message;   // ej. 409: documento o correo repetido
        }
        finally
        {
            guardando = false;
        }
    }
}
