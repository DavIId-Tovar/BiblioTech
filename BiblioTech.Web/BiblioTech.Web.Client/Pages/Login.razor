@page "/login"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject AuthApiService AuthApi
@inject NavigationManager Nav

<PageTitle>Iniciar sesión · BiblioTech</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-sm-10 col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">📚 BiblioTech</h1>
                <p class="text-secondary mb-4">Ingreso del bibliotecario</p>

                <Alerta Mensaje="@error" Tipo="danger" OnCerrar="() => error = null" />

                @* EditForm + DataAnnotationsValidator: valida en el navegador con los mismos atributos del modelo *@
                <EditForm Model="modelo" OnValidSubmit="IngresarAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="email">Correo</label>
                        <InputText id="email" class="form-control" @bind-Value="modelo.Email" autocomplete="username" />
                        <ValidationMessage For="() => modelo.Email" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label" for="password">Contraseña</label>
                        <InputText id="password" type="password" class="form-control" @bind-Value="modelo.Password" autocomplete="current-password" />
                        <ValidationMessage For="() => modelo.Password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@enviando">
                        @(enviando ? "Ingresando..." : "Ingresar")
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginDto modelo = new();
    private string? error;
    private bool enviando;

    private async Task IngresarAsync()
    {
        enviando = true;
        error = null;
        try
        {
            await AuthApi.IniciarSesionAsync(modelo);
            Nav.NavigateTo("");   // al inicio (dashboard)
        }
        catch (ApiException ex)
        {
            error = ex.Message;   // ej. "Correo o contraseña incorrectos." (401 de la API)
        }
        finally
        {
            enviando = false;
        }
    }
}
