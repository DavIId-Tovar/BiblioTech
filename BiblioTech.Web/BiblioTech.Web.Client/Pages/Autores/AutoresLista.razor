@page "/autores"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inherits PaginaProtegida
@inject AutorApiService AutorApi
@inject NotificacionService Notificaciones

<PageTitle>Autores · BiblioTech</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Autores</h1>
    <a class="btn btn-primary" href="autores/nuevo">+ Nuevo autor</a>
</div>

<Alerta Mensaje="@mensaje" Tipo="@tipoMensaje" OnCerrar="() => mensaje = null" />

@if (autores is null)
{
    @if (mensaje is null || tipoMensaje == "success") { <Cargando /> }
}
else if (autores.Count == 0)
{
    <p class="text-secondary">No hay autores registrados.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Nacionalidad</th>
                    <th class="text-center">Libros</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var autor in autores)
                {
                    <tr>
                        <td>@autor.Nombre</td>
                        <td>@(autor.Nacionalidad ?? "—")</td>
                        <td class="text-center">@autor.CantidadLibros</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" href="autores/editar/@autor.Id">Editar</a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => porEliminar = autor">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<ConfirmarModal Visible="porEliminar is not null"
                Titulo="Eliminar autor"
                Mensaje="@($"¿Eliminar a {porEliminar?.Nombre}? Esta acción no se puede deshacer.")"
                TextoConfirmar="Eliminar"
                OnConfirmar="EliminarAsync"
                OnCancelar="() => porEliminar = null" />

@code {
    private List<AutorDto>? autores;
    private AutorDto? porEliminar;
    private string? mensaje;
    private string tipoMensaje = "danger";

    // Si venimos de crear o editar, el formulario dejó un mensaje de éxito
    protected override void OnInitialized()
    {
        if (Notificaciones.Tomar() is { } exito)
            (mensaje, tipoMensaje) = (exito, "success");
    }

    protected override async Task CargarAsync()
    {
        try
        {
            autores = await AutorApi.ListarAsync();
        }
        catch (ApiException ex)
        {
            Mostrar(ex.Message, "danger");
        }
    }

    private async Task EliminarAsync()
    {
        var autor = porEliminar!;
        porEliminar = null;
        try
        {
            await AutorApi.EliminarAsync(autor.Id);
            Mostrar($"Se eliminó a {autor.Nombre}.", "success");
            await CargarAsync();
        }
        catch (ApiException ex)
        {
            Mostrar(ex.Message, "danger");   // ej. 409: el autor tiene libros
        }
    }

    private void Mostrar(string texto, string tipo) => (mensaje, tipoMensaje) = (texto, tipo);
}
