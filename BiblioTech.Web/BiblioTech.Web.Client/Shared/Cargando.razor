@* Indicador de carga mientras llega la respuesta de la API. *@

<div class="d-flex align-items-center gap-2 text-secondary my-4">
    <div class="spinner-border spinner-border-sm" role="status"></div>
    <span>@Texto</span>
</div>

@code {
    [Parameter] public string Texto { get; set; } = "Cargando...";
}
