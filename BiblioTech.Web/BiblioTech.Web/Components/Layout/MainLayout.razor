@inherits LayoutComponentBase

@* El layout es ESTÁTICO (lo dibuja el servidor). La única parte interactiva es
   MenuSesion, que vive en Web.Client y corre en WebAssembly (una "isla"). *@
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <MenuSesion @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: false))" />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
